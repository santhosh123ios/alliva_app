NODE_ENV=development
# Local Postgres. For Supabase, replace both URLs from Project Settings → Database.
# DATABASE_URL: Transaction pooler, port 6543, add ?pgbouncer=true&connection_limit=15&pool_timeout=20&sslmode=require
# Keep connection_limit at 1 only for serverless. This API is one long-running process and needs a real pool.
# DIRECT_URL: Session pooler or direct host, port 5432, add ?sslmode=require
# Enable the postgis extension in the Supabase SQL editor before migrating.
DATABASE_URL=postgresql://alliva:alliva@localhost:5432/alliva?schema=public
DIRECT_URL=postgresql://alliva:alliva@localhost:5432/alliva?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
COOKIE_SECURE=false
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SMS_DEV_CODE=123456
TWO_FACTOR_DEV_CODE=000000
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alliva
S3_ACCESS_KEY=alliva
S3_SECRET_KEY=alliva-secret
S3_REGION=us-east-1
EMAIL_FROM=noreply@alliva.bh
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=dev-tap-secret
BENEFIT_WEBHOOK_SECRET=dev-benefit-secret
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
PLATFORM_TIMEZONE=Asia/Bahrain
PLATFORM_CURRENCY=BHD
UPLOAD_DIR=uploads
