NODE_ENV=development
# Local Postgres. For Supabase, replace both URLs from Project Settings → Database.
# DATABASE_URL: Transaction pooler, port 6543, add ?pgbouncer=true&connection_limit=15&pool_timeout=20&sslmode=require
# Keep connection_limit at 1 only for serverless. This API is one long-running process and needs a real pool.
# DIRECT_URL: Session pooler or direct host, port 5432, add ?sslmode=require
# Enable the postgis extension in the Supabase SQL editor before migrating.
DATABASE_URL=postgresql://alliva:alliva@localhost:5432/alliva?schema=public
DIRECT_URL=postgresql://alliva:alliva@localhost:5432/alliva?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
COOKIE_SECURE=false
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SMS_DEV_CODE=123456
# WhatsApp Cloud API. Leave the token blank in development to log the code and accept SMS_DEV_CODE.
# Create an approved Authentication template (copy-code button) in English and Arabic.
# The code is sent in the body and in the copy-code button. Template languages: en and ar.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=alliva_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_LANGUAGE_AR=ar
WHATSAPP_GRAPH_VERSION=v23.0
TWO_FACTOR_DEV_CODE=000000
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alliva
S3_ACCESS_KEY=alliva
S3_SECRET_KEY=alliva-secret
S3_REGION=us-east-1
EMAIL_FROM=Alliva <noreply@alliva.bh>
# Resend (https://resend.com). Leave the key blank to log emails instead of sending them.
# The from address must use a domain verified in Resend.
RESEND_API_KEY=
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=dev-tap-secret
BENEFIT_WEBHOOK_SECRET=dev-benefit-secret
GOOGLE_MAPS_API_KEY=
# Firebase Authentication phone sign-in. Web app config from Project settings.
# Enable Phone in Authentication → Sign-in method, and add localhost to authorized domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
PLATFORM_TIMEZONE=Asia/Bahrain
PLATFORM_CURRENCY=BHD
UPLOAD_DIR=uploads
# Marketing module. In-app reminders are produced by a scheduler inside the API; set to false to disable it
# (for example when you run several API instances and want only one of them to send reminders).
MARKETING_JOBS_ENABLED=true
# Build-time URLs (Vite) used to build the referral link and invitation links shown in the admin and marketing portals.
# Leave unset in local development; set them to the public portal origins in production.
# VITE_MERCHANT_URL=https://merchant.example.com
# VITE_MARKETING_URL=https://marketing.example.com
