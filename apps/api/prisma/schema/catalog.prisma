model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  parentId   String?  @db.Uuid
  name       Json
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  parent     ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children   ProductCategory[] @relation("CategoryTree")
  products   Product[]

  @@index([merchantId])
}

model Product {
  id             String                @id @default(uuid()) @db.Uuid
  merchantId     String                @db.Uuid
  categoryId     String                @db.Uuid
  slug           String
  name           Json
  description    Json
  price          Decimal               @db.Decimal(19, 3)
  compareAtPrice Decimal?              @db.Decimal(19, 3)
  imageUrl       String?
  available      Boolean               @default(true)
  approvalStatus ProductApprovalStatus @default(APPROVED)
  availableFrom  String?
  availableUntil String?
  ratingAverage  Decimal               @default(0) @db.Decimal(4, 2)
  ratingCount    Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdById    String?               @db.Uuid
  updatedById    String?               @db.Uuid
  deletedAt      DateTime?
  merchant       Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category       ProductCategory       @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  addonGroups    ProductAddonGroup[]
  inventory      InventoryItem[]
  views          RecentlyViewed[]

  @@unique([merchantId, slug])
  @@index([merchantId, approvalStatus])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  merchantId  String   @db.Uuid
  name        Json
  price       Decimal  @db.Decimal(19, 3)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AddonGroup {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  name       Json
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  addons     Addon[]
  products   ProductAddonGroup[]

  @@index([merchantId])
}

model Addon {
  id        String     @id @default(uuid()) @db.Uuid
  groupId   String     @db.Uuid
  merchantId String    @db.Uuid
  name      Json
  price     Decimal    @db.Decimal(19, 3)
  available Boolean    @default(true)
  group     AddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model ProductAddonGroup {
  productId    String @db.Uuid
  addonGroupId String @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  @@id([productId, addonGroupId])
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @db.Uuid
  branchId          String   @db.Uuid
  productId         String   @db.Uuid
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([merchantId])
}

model Offer {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid
  title      Json
  active     Boolean  @default(true)
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, active])
}

model Banner {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @db.Uuid
  title      Json
  imageUrl   String?
  status     BannerStatus @default(PENDING)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status])
}
