{
  "name": "@alliva/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-env.mjs tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node scripts/with-env.mjs node dist/main.js",
    "lint": "echo ok",
    "test": "node scripts/with-env.mjs jest --runInBand && node scripts/with-env.mjs node --import tsx --test --test-force-exit test/orders.integration.spec.ts test/marketing.integration.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@alliva/types": "workspace:*",
    "@alliva/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pdf-lib": "1.17.1",
    "prisma": "6.19.3",
    "socket.io": "4.8.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
